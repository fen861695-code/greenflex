# Server-only configuration. Never add secrets with a VITE_ prefix.
GREENFLEX_ENV=development
GREENFLEX_API_HOST=127.0.0.1
GREENFLEX_API_PORT=8000
# If you change API_PORT, also set it for the frontend dev server:
#   set GREENFLEX_API_PORT=8001 (Windows) / export GREENFLEX_API_PORT=8001 (Linux/Mac)
# Frontend port can be changed with: set VITE_PORT=5174
GREENFLEX_WEB_ORIGIN=http://127.0.0.1:5173
GREENFLEX_DATABASE_URL=sqlite+aiosqlite:///./data/greenflex.db
GREENFLEX_ARTIFACT_DIR=./artifacts
GREENFLEX_OLLAMA_BASE_URL=http://127.0.0.1:11434
GREENFLEX_OLLAMA_CONNECT_TIMEOUT_SECONDS=1
GREENFLEX_OLLAMA_REQUEST_TIMEOUT_SECONDS=300
GREENFLEX_MODEL_CACHE=D:\GreenFlex\models
GREENFLEX_TELEMETRY_INTERVAL_MS=500
GREENFLEX_TELEMETRY_IDLE_SECONDS=3
GREENFLEX_WORKER_POLL_SECONDS=1
GREENFLEX_WORKER_LEASE_SECONDS=600
GREENFLEX_SIMULATION_CLOCK_SCALE=1
GREENFLEX_LOG_LEVEL=INFO
GREENFLEX_GRID_REGION=CN-East
GREENFLEX_NVML_ENABLED=false

# Cloud API keys (optional — when unset, simulated inference is used)
# Get keys from:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/
#   DeepSeek:  https://platform.deepseek.com/
#   Alibaba:   https://help.aliyun.com/zh/model-studio/
#   ByteDance: https://www.volcengine.com/product/doubao
#   Google:    https://aistudio.google.com/apikey
GREENFLEX_OPENAI_API_KEY=
GREENFLEX_ANTHROPIC_API_KEY=
GREENFLEX_DEEPSEEK_API_KEY=
GREENFLEX_ALIBABA_API_KEY=
GREENFLEX_BYTEDANCE_API_KEY=
GREENFLEX_GOOGLE_API_KEY=

# Optional: override cloud API base URLs (for proxies/self-hosted gateways)
# GREENFLEX_OPENAI_BASE_URL=https://api.openai.com/v1
# GREENFLEX_DEEPSEEK_BASE_URL=https://api.deepseek.com
# GREENFLEX_ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GREENFLEX_CLOUD_API_TIMEOUT_SECONDS=120

# Admin token for settings write API (auto-generated if not set)
# When unset, a random token is generated on first run and saved to artifacts/admin_token.txt
# GREENFLEX_ADMIN_TOKEN=your-custom-admin-token
