# Server-only configuration. Never add secrets with a VITE_ prefix.
GREENFLEX_ENV=development
GREENFLEX_API_HOST=127.0.0.1
GREENFLEX_API_PORT=8000
GREENFLEX_WEB_ORIGIN=http://127.0.0.1:5173
GREENFLEX_DATABASE_URL=sqlite+aiosqlite:///./data/greenflex.db
GREENFLEX_ARTIFACT_DIR=./artifacts
GREENFLEX_OLLAMA_BASE_URL=http://127.0.0.1:11434
GREENFLEX_OLLAMA_CONNECT_TIMEOUT_SECONDS=1
GREENFLEX_OLLAMA_REQUEST_TIMEOUT_SECONDS=300
GREENFLEX_MODEL_CACHE=D:\GreenFlex\models
GREENFLEX_TELEMETRY_INTERVAL_MS=500
GREENFLEX_TELEMETRY_IDLE_SECONDS=3
GREENFLEX_WORKER_POLL_SECONDS=1
GREENFLEX_WORKER_LEASE_SECONDS=600
GREENFLEX_SIMULATION_CLOCK_SCALE=1
GREENFLEX_LOG_LEVEL=INFO

# --- Real-time carbon intensity (v2) ---
# Electricity Maps API key (optional, free tier at https://www.electricitymaps.com/)
GREENFLEX_ELECTRICITY_MAPS_API_KEY=
# Region code for carbon intensity (ISO 3166-2, e.g. CN-HN for Hunan)
GREENFLEX_CARBON_INTENSITY_REGION=CN-HN
# Electricity Maps zone code (e.g. CN-CS for Central-South China)
GREENFLEX_ELECTRICITY_MAPS_ZONE=CN-CS
# Cache TTL in minutes (default 15)
GREENFLEX_CARBON_INTENSITY_CACHE_TTL_MINUTES=15
# Provider chain priority (comma-separated)
GREENFLEX_CARBON_PROVIDER_CHAIN=electricity_maps,dynlca,fallback

# --- Energy estimation (v2) ---
# Local GPU model for energy estimation calibration
GREENFLEX_LOCAL_GPU_MODEL=rtx-3060-laptop
# Enable five-tier energy estimator
GREENFLEX_ENERGY_ESTIMATOR_ENABLED=true
# Auto-calibrate GPU efficiency from local measurements
GREENFLEX_AUTO_CALIBRATE_GPU=true

# --- RL Router (v2) ---
# Enable reinforcement learning router (shadow mode by default)
GREENFLEX_RL_ROUTER_ENABLED=true
# RL router mode: disabled, shadow, advisory, autonomous
GREENFLEX_RL_ROUTER_MODE=shadow
# Path to save/load RL policy
GREENFLEX_RL_ROUTER_POLICY_PATH=data/rl_policy.json

# --- C2PA (v2) ---
# Enable C2PA-compatible Token Passport
GREENFLEX_C2PA_ENABLED=true
# Secret key for HMAC-SHA256 signing (change this in production)
GREENFLEX_C2PA_SECRET_KEY=greenflex-local

# --- AI Act Compliance (v2) ---
# Enable AI Act compliance reporting
GREENFLEX_AI_ACT_COMPLIANCE_ENABLED=true
